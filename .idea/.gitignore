# Default ignored files
/shelf/
/workspace.xml
# Datasource local storage ignored files
/dataSources/
/dataSources.local.xml

# Node.js dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs
logs
*.log
*.log.*

# Dependency directories
/.pnp
.pnp.js

# Build directories
dist/
build/
out/

# Environment files
.env
.env.local
.env.*.local

# OS-generated files
.DS_Store
Thumbs.db

# Editor & IDE files
.vscode/
.idea/            # IntelliJ IDEA folder
*.iml             # IntelliJ IDEA project files
*.suo             # Visual Studio files
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript
*.tsbuildinfo

# Optional npm cache directory
.npm/

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Coverage directory used by tools like jest or c8
coverage/

# Binaries
*.exe
*.dll
*.so
*.dylib

# Optional REPL history
.node_repl_history

# Yarn
.yarn/*
!.yarn/cache
!.yarn/unplugged
!.yarn/build-state.yml
!.yarn/install-state.gz

.idea/
*.iml


